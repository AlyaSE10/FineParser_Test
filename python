
import csv
import time
from datetime import datetime
from pathlib import Path

import requests


BASE = "http://localhost:8080"          # where FineParser is running
FORMATS = ["doclang"]                    # any of: "doclang", "json", "txt"
INPUT_DIR = Path("input")
OUTPUT_DIR = Path("output")
SUPPORTED = {".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp"}
TIMEOUT_SECONDS = 300                    # give up on one file after this
SKIP_ALREADY_DONE = True                 # saves your monthly page quota
# ----------------------------------------------------------

EXTENSION = {"doclang": ".doclang", "json": ".json", "txt": ".txt"}


def parse_one(path: Path, output_type: str) -> bytes:
    """Submit one file, wait for the job, return the result bytes."""
    with open(path, "rb") as f:
        submitted = requests.post(
            f"{BASE}/parse",
            files={"file": (path.name, f)},
            data={"outputType": output_type},
        )
    submitted.raise_for_status()
    job_id = submitted.json()["jobId"]

    start = time.time()
    while True:
        job = requests.get(f"{BASE}/jobs/{job_id}").json()
        if job["status"] not in ("pending", "in-progress"):
            break
        if time.time() - start > TIMEOUT_SECONDS:
            raise TimeoutError(f"no result after {TIMEOUT_SECONDS}s")
        time.sleep(1)

    if job["status"] != "successful":
        raise RuntimeError(job.get("error", job["status"]))

    result = requests.get(f"{BASE}/jobs/{job['file']}")
    result.raise_for_status()
    return result.content


def main():
    INPUT_DIR.mkdir(exist_ok=True)
    OUTPUT_DIR.mkdir(exist_ok=True)
    for fmt in FORMATS:
        (OUTPUT_DIR / fmt).mkdir(exist_ok=True)

    files = sorted(p for p in INPUT_DIR.iterdir()
                   if p.is_file() and p.suffix.lower() in SUPPORTED)
    if not files:
        print(f"No supported files found in '{INPUT_DIR}'. "
              f"Supported: {', '.join(sorted(SUPPORTED))}")
        return

    print(f"Found {len(files)} file(s). Formats: {', '.join(FORMATS)}\n")

    log_path = OUTPUT_DIR / "parse_log.csv"
    new_log = not log_path.exists()
    with open(log_path, "a", newline="", encoding="utf-8") as log_file:
        log = csv.writer(log_file)
        if new_log:
            log.writerow(["time", "file", "format", "status", "seconds", "error"])

        for i, path in enumerate(files, start=1):
            for fmt in FORMATS:
                target = OUTPUT_DIR / fmt / (path.name + EXTENSION[fmt])
                label = f"[{i}/{len(files)}] {path.name} -> {fmt}"

                if SKIP_ALREADY_DONE and target.exists():
                    print(f"{label}: skipped (already done)")
                    continue

                t0 = time.time()
                try:
                    data = parse_one(path, fmt)
                    target.write_bytes(data)
                    secs = round(time.time() - t0, 1)
                    print(f"{label}: done in {secs}s")
                    log.writerow([datetime.now().isoformat(timespec="seconds"),
                                  path.name, fmt, "ok", secs, ""])
                except requests.exceptions.ConnectionError:
                    print(f"{label}: FAILED - cannot reach FineParser at {BASE}. "
                          f"Is the container running?")
                    log.writerow([datetime.now().isoformat(timespec="seconds"),
                                  path.name, fmt, "failed", "", "connection refused"])
                    log_file.flush()
                    return  # no point trying the remaining files
                except Exception as e:  # keep going with the next file
                    secs = round(time.time() - t0, 1)
                    print(f"{label}: FAILED - {e}")
                    log.writerow([datetime.now().isoformat(timespec="seconds"),
                                  path.name, fmt, "failed", secs, str(e)])
                log_file.flush()

    print(f"\nFinished. Results in '{OUTPUT_DIR}', log in '{log_path}'.")


if __name__ == "__main__":
    main()